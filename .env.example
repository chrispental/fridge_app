# Copy this file to `.env` and fill in your OpenRouter API key.
# Get a key at https://openrouter.ai/keys
#
# Both API keys are technically optional — the app boots without them and
# degrades gracefully (no AI features without OpenRouter; no recipe photos,
# source links, weather-aware grilling, or delivery search without Brave).

OPENROUTER_API_KEY=sk-or-v1-replace-me

# Models (any OpenRouter model slug). The vision model MUST support image input.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_MEAL_MODEL=anthropic/claude-sonnet-4.6

# Brave Search (paid key) — recipe images, related recipe links,
# grilling-weather lookups, and delivery search. Get a key at https://brave.com/search/api/
BRAVE_API_KEY=brv-replace-me

# Country bias for Brave Search results (ISO 3166-1 alpha-2).
BRAVE_COUNTRY=US

# --- The defaults below are fine for Docker; change only if you know why. ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BRAVE_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_REQUEST_TIMEOUT=10
WEATHER_CACHE_TTL=3600
DATABASE_URL=sqlite:////app/data/fridge.db
UPLOAD_DIR=/app/data/uploads
MAX_IMAGE_DIM=1024
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_REQUEST_TIMEOUT=90
# Published Docker ports stay on this machine unless explicitly overridden.
FRIDGE_BIND_HOST=127.0.0.1

# --- Cloud mode with Supabase (optional) -----------------------------------------
# Leave ALL of these empty for the default single-user local mode (SQLite file, no
# login, photos on the ./data volume). Setting SUPABASE_URL switches the backend to
# require a Supabase Auth login on every request; VITE_* do the same for the browser.
# Full walkthrough: README → "Cloud mode with Supabase".
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...            # backend only; NEVER a VITE_ var
# SUPABASE_STORAGE_BUCKET=fridge-photos        # private bucket for uploaded photos
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # baked into the frontend build
#
# Postgres via the Supavisor SESSION pooler (port 5432, IPv4-friendly). The direct
# db.<ref>.supabase.co host is IPv6-only without the paid IPv4 add-on.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Advanced: the fixed user id used in local mode. Don't change after first run.
# LOCAL_USER_ID=00000000-0000-0000-0000-000000000001

# --- Optional MCP (off by default; full setup: docs/mcp.md) ---------------------
# Simplest local test: docker compose -f docker-compose.mcp-local.yml -p fridge-mcp-local up --build -d
# That standalone stack uses no env_file, no keys, and an isolated named volume;
# leave this file alone for that quickstart. Never merge it with a public/cloud stack.
MCP_ENABLED=false
MCP_MODE=remote
# Remote is the default and never falls back to unauthenticated local access.
# Remote mode only. Requires a dedicated OAuth issuer, public client code + PKCE,
# RFC 9068 access JWTs (<=900s), exact single /mcp audience and fridge:* API scopes.
# Ordinary Supabase sessions/OIDC scopes are incompatible. No client secrets or
# access tokens belong here. Keep these settings backend-only, never VITE_*.
# MCP_RESOURCE_URL=https://fridge.example.com/mcp
# MCP_ISSUER_URL=https://example-tenant.us.auth0.com/
# MCP_JWKS_URL=https://example-tenant.us.auth0.com/.well-known/jwks.json
# One-line JSON, verified issuer subject + registered client -> existing app user.
# Fake IDs below: replace ALL with verified values. Start read-only.
# MCP_GRANTS='[{"subject":"auth0|example-user-id","client_id":"example-claude-client-id","user_id":"6d452110-890f-41d0-9a52-f0a47de4a8bb","scopes":["fridge:read"]}]'
# Shopping also needs fridge:shopping in BOTH the provider token and this grant.
# Grants are not DB rows. Changes/revocation require recreating ALL backend replicas;
# docker compose restart alone does not reload a changed env_file. With no grants,
# keep MCP_ENABLED=false. See docs/mcp.md for revocation and proxy checks.
