# Copy this file to `.env` and fill in your OpenRouter API key.
# Get a key at https://openrouter.ai/keys
#
# Both API keys are technically optional — the app boots without them and
# degrades gracefully (no AI features without OpenRouter; no recipe photos,
# source links, weather-aware grilling, or delivery search without Brave).

OPENROUTER_API_KEY=sk-or-v1-replace-me

# Models (any OpenRouter model slug). The vision model MUST support image input.
OPENROUTER_VISION_MODEL=openai/gpt-4o-mini
OPENROUTER_MEAL_MODEL=anthropic/claude-sonnet-4.6

# Brave Search (paid key) — recipe images, "view full recipe" links,
# grilling-weather lookups, and delivery search. Get a key at https://brave.com/search/api/
BRAVE_API_KEY=brv-replace-me

# Country bias for Brave Search results (ISO 3166-1 alpha-2).
BRAVE_COUNTRY=US

# --- The defaults below are fine for Docker; change only if you know why. ---
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BRAVE_BASE_URL=https://api.search.brave.com/res/v1
BRAVE_REQUEST_TIMEOUT=10
WEATHER_CACHE_TTL=3600
DATABASE_URL=sqlite:////app/data/fridge.db
UPLOAD_DIR=/app/data/uploads
MAX_IMAGE_DIM=1024
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AI_REQUEST_TIMEOUT=90

# --- Cloud mode with Supabase (optional) -----------------------------------------
# Leave ALL of these empty for the default single-user local mode (SQLite file, no
# login, photos on the ./data volume). Setting SUPABASE_URL switches the backend to
# require a Supabase Auth login on every request; VITE_* do the same for the browser.
# Full walkthrough: README → "Cloud mode with Supabase".
#
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...            # backend only; NEVER a VITE_ var
# SUPABASE_STORAGE_BUCKET=fridge-photos        # private bucket for uploaded photos
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...   # baked into the frontend build
#
# Postgres via the Supavisor SESSION pooler (port 5432, IPv4-friendly). The direct
# db.<ref>.supabase.co host is IPv6-only without the paid IPv4 add-on.
# DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Advanced: the fixed user id used in local mode. Don't change after first run.
# LOCAL_USER_ID=00000000-0000-0000-0000-000000000001
